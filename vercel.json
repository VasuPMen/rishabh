{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agent": {
      "root": "agent",
      "framework": "fastapi"
    },
    "ui": {
      "root": "ui",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "agent"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ui"
      }
    }
  ]
}
